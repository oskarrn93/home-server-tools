WEBUI_AUTH=True
ENABLE_SIGNUP=False
DEFAULT_USER_ROLE=user
WEBUI_SECRET_KEY=replace-with-a-random-long-secret
OPENAI_API_KEYS=sk-replace-with-a-litellm-key

# --- SSO (Pocket ID "Open WebUI" OIDC client) ---
ENABLE_OAUTH_SIGNUP=true
OAUTH_CLIENT_ID=replace-with-openwebui-oidc-client-id
OAUTH_CLIENT_SECRET=replace-with-openwebui-oidc-client-secret
OPENID_PROVIDER_URL=https://oidc.oskarrosen.io/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://openwebui.oskarrosen.io/oauth/oidc/callback
OAUTH_SCOPES=openid email profile
OAUTH_PROVIDER_NAME=Pocket ID
# Pocket ID client is provisioned with pkceEnabled=true (auth/terraform/main.tf),
# so PKCE is required. Open WebUI doesn't auto-detect this from the provider's
# discovery metadata - it must be set explicitly or the auth request is rejected
# with "This client requires PKCE".
OAUTH_CODE_CHALLENGE_METHOD=S256
# Link SSO logins to the existing local account with the same email instead of
# failing with "email already registered" (defaults to false).
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
