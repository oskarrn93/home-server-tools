N8N_ENCRYPTION_KEY=replace-with-a-random-long-secret
N8N_SANDBOX_SERVICE_API_KEY=must-match-a-value-in-n8n-sandbox.env-SANDBOX_API_KEYS
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_INSTANCE_AI_MODEL_API_KEY=sk-replace-with-a-litellm-key

# media-services job workflows (see terraform/workflows/)
QBIT_URL=http://vpn:8082
QBIT_USERNAME=replace-with-qbittorrent-username
QBIT_PASSWORD=replace-with-qbittorrent-password
SABNZBD_URL=http://vpn:8083/sabnzbd/api
SABNZBD_APIKEY=replace-with-sabnzbd-api-key
SEERR_URL=http://seerr:5055
SEERR_API_KEY=replace-with-seerr-api-key
TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=replace-with-tautulli-api-key

