LITELLM_MASTER_KEY=replace-with-a-random-sk--prefixed-secret
DATABASE_URL=postgresql://litellm:replace-with-password@host.docker.internal:5432/litellm
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=litellm
REDIS_PASSWORD=replace-with-valkey-litellm-password
REDIS_DB=4
LITELLM_OTEL_V2=true
LITELLM_OTEL_INTEGRATION_ENABLE_METRICS=true
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://host.docker.internal:4318
OTEL_SERVICE_NAME=litellm
