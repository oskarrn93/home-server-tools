LITELLM_MASTER_KEY=replace-with-a-random-sk--prefixed-secret
DATABASE_URL=postgresql://litellm:replace-with-password@host.docker.internal:5432/litellm
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=litellm
REDIS_PASSWORD=replace-with-valkey-litellm-password
REDIS_DB=4
LITELLM_OTEL_V2=true
LITELLM_OTEL_INTEGRATION_ENABLE_METRICS=true
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://host.docker.internal:4318
OTEL_SERVICE_NAME=litellm

# --- SSO (Pocket ID "LiteLLM" OIDC client) ---
PROXY_BASE_URL=https://litellm.oskarrosen.io
GENERIC_CLIENT_ID=replace-with-litellm-oidc-client-id
GENERIC_CLIENT_SECRET=replace-with-litellm-oidc-client-secret
GENERIC_AUTHORIZATION_ENDPOINT=https://oidc.oskarrosen.io/authorize
GENERIC_TOKEN_ENDPOINT=https://oidc.oskarrosen.io/api/oidc/token
GENERIC_USERINFO_ENDPOINT=https://oidc.oskarrosen.io/api/oidc/userinfo
GENERIC_SCOPE=openid profile email
GENERIC_CLIENT_USE_PKCE=true
