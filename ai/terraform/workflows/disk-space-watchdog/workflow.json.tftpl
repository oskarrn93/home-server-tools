{
  "name": "Disk Space Watchdog",
  "settings": {},
  "nodes": [
    {
      "id": "trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      }
    },
    {
      "id": "sonarr-diskspace",
      "name": "Sonarr Diskspace (hdd1)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, -100],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": ${jsonencode(sonarr_js)}
      }
    },
    {
      "id": "radarr-diskspace",
      "name": "Radarr Diskspace (hdd1)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": ${jsonencode(radarr_js)}
      }
    },
    {
      "id": "readarr-diskspace",
      "name": "Readarr Diskspace (hdd3)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 100],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": ${jsonencode(readarr_js)}
      }
    },
    {
      "id": "merge-diskspace",
      "name": "Merge Diskspace",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [440, 0],
      "parameters": {
        "mode": "append",
        "numberInputs": 3
      }
    },
    {
      "id": "evaluate",
      "name": "Evaluate Thresholds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": ${jsonencode(evaluate_js)}
      }
    },
    {
      "id": "is-low",
      "name": "Below Threshold",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [880, 0],
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{$json.lowCount}}", "operation": "larger", "value2": 0 }]
        }
      }
    },
    {
      "id": "notify",
      "name": "Notify",
      "type": "n8n-nodes-base.pushover",
      "typeVersion": 1,
      "position": [1100, 0],
      "parameters": {
        "userKey": "__PUSHOVER_USER_KEY__",
        "title": "Disk Space Low",
        "message": "={{$json.message}}",
        "additionalFields": { "priority": 1 }
      },
      "credentials": {
        "pushoverApi": { "id": "__PUSHOVER_CREDENTIAL_ID__", "name": "Pushover account" }
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [[
        { "node": "Sonarr Diskspace (hdd1)", "type": "main", "index": 0 },
        { "node": "Radarr Diskspace (hdd1)", "type": "main", "index": 0 },
        { "node": "Readarr Diskspace (hdd3)", "type": "main", "index": 0 }
      ]]
    },
    "Sonarr Diskspace (hdd1)": {
      "main": [[{ "node": "Merge Diskspace", "type": "main", "index": 0 }]]
    },
    "Radarr Diskspace (hdd1)": {
      "main": [[{ "node": "Merge Diskspace", "type": "main", "index": 1 }]]
    },
    "Readarr Diskspace (hdd3)": {
      "main": [[{ "node": "Merge Diskspace", "type": "main", "index": 2 }]]
    },
    "Merge Diskspace": {
      "main": [[{ "node": "Evaluate Thresholds", "type": "main", "index": 0 }]]
    },
    "Evaluate Thresholds": {
      "main": [[{ "node": "Below Threshold", "type": "main", "index": 0 }]]
    },
    "Below Threshold": {
      "main": [[{ "node": "Notify", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {}
}
