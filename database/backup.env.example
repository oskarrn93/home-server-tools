# Copy to database/backup.env (gitignored) and fill in real credentials.
# These match the app database/user created by ansible/local-databases.yml
# (see database/README.md "Connection details" for the defaults on this host).
#
# Valkey isn't backed up - it only holds cache/queue/broker data for the apps
# (SearXNG query cache, Immich's BullMQ job queue, Paperless-ngx's task
# broker, LiteLLM's response cache), none of which is durable state; losing
# it just means caches repopulate and in-flight jobs get re-queued.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=app
MARIADB_USER=app
MARIADB_PASSWORD=changeme

# Optional: Prometheus Pushgateway URL for backup alerting. Defaults to
# http://localhost:9092 (server-observability's pushgateway container, mapped
# to host port 9092). The DatabaseBackupStale rule in
# server-observability/prometheus-rules/database-alerts.yaml pages if no
# successful push has landed in over 26h.
BACKUP_PUSHGATEWAY_URL=
