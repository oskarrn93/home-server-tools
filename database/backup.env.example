# database/backup.env is written by ansible/local-databases.yml from
# vars/local-databases.yml (postgres_backup_*, mariadb_backup_*, backup_root,
# backup_pushgateway_url) - only copy this by hand if you're not using Ansible.
#
# The backup users are read-only roles that can dump every database:
# PostgreSQL pg_read_all_data, MariaDB SELECT/SHOW VIEW/TRIGGER/LOCK TABLES/EVENT.
# Valkey isn't backed up - it only holds cache/queue/broker data.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backup
POSTGRES_PASSWORD=changeme

MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=backup
MARIADB_PASSWORD=changeme

# Optional: root directory for timestamped dumps (each script appends its own
# postgres/mariadb subdirectory). Defaults to ./backups next to the scripts.
BACKUP_ROOT=

# Optional: Prometheus Pushgateway URL for backup alerting. Defaults to
# http://localhost:9092 (server-observability's pushgateway container). The
# DatabaseBackupStale rule in
# server-observability/prometheus-rules/database-alerts.yaml pages if no
# successful push has landed in over 26h.
BACKUP_PUSHGATEWAY_URL=
