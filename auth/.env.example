# --- Pocket ID ---
APP_URL=https://oidc.oskarrosen.io
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
TRUST_PROXY=true
PUID=1000
PGID=1000
# Provisioned by home-server-tools/database/ansible/local-databases.yml
DB_CONNECTION_STRING=postgresql://pocketid:<password>@host.docker.internal:5432/pocketid?sslmode=disable
# Prometheus metrics endpoint (scraped by server-observability); host must be 0.0.0.0
# to be reachable from other containers, not just localhost
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0
OTEL_EXPORTER_PROMETHEUS_PORT=9464

# --- tinyauth ---
TINYAUTH_APPURL=https://auth.oskarrosen.io
TINYAUTH_AUTH_TRUSTEDPROXIES=172.16.0.0/12,192.168.1.0/24
TINYAUTH_AUTH_SECURECOOKIE=true
# Provisioned by home-server-tools/database/ansible/local-databases.yml
TINYAUTH_DATABASE_DRIVER=postgres
TINYAUTH_DATABASE_PATH=postgresql://tinyauth:<password>@host.docker.internal:5432/tinyauth?sslmode=disable
# Redirect straight to Pocket ID's passkey login instead of tinyauth's own form
TINYAUTH_OAUTH_AUTOREDIRECT=pocketid
# Filled in after creating the "tinyauth" OIDC client in the Pocket ID admin UI
# (see home-server-tools/auth/README.md)
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID=
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRET=
TINYAUTH_OAUTH_PROVIDERS_POCKETID_AUTHURL=https://oidc.oskarrosen.io/authorize
TINYAUTH_OAUTH_PROVIDERS_POCKETID_TOKENURL=https://oidc.oskarrosen.io/api/oidc/token
TINYAUTH_OAUTH_PROVIDERS_POCKETID_USERINFOURL=https://oidc.oskarrosen.io/api/oidc/userinfo
TINYAUTH_OAUTH_PROVIDERS_POCKETID_REDIRECTURL=https://auth.oskarrosen.io/api/oauth/callback/pocketid
TINYAUTH_OAUTH_PROVIDERS_POCKETID_SCOPES=openid email profile groups
TINYAUTH_OAUTH_PROVIDERS_POCKETID_NAME=Pocket ID
